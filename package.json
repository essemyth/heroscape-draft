{
  "name": "heroscape-draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "import-units": "node scripts/import-units.mjs && node scripts/build-synergies.mjs",
    "import-collection": "node scripts/import-collection.mjs",
    "test": "vitest run",
    "photos": "node scripts/photos.mjs",
    "synergies": "node scripts/build-synergies.mjs",
    "dev:server": "node --watch server/index.ts",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
