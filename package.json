{
  "name": "heroscape-draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "import-units": "node scripts/import-units.mjs",
    "import-collection": "node scripts/import-collection.mjs",
    "test": "vitest run",
    "sync-shared": "node scripts/sync-shared.mjs",
    "deploy:db": "supabase db push",
    "deploy:functions": "node scripts/sync-shared.mjs && supabase functions deploy draft-action --use-api"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
